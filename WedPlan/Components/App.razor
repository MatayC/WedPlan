<!DOCTYPE html>
<html lang="de">

<head>
    <meta charset="utf-8" />

    <!-- Viewport: viewport-fit=cover ermöglicht Nutzung des safe-area-inset auf iPhone mit Notch/Dynamic Island -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

    <base href="/" />
    <ResourcePreloader />

    <!-- ═══ PWA Manifest ═══ -->
    <link rel="manifest" href="/manifest.json" />

    <!-- ═══ PWA / Theme-Farben ═══ -->
    <!-- theme-color wird von Chrome/Android für die Browser-Toolbar verwendet -->
    <meta name="theme-color" content="#D6A6AC" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#2D1B1F" media="(prefers-color-scheme: dark)" />

    <!-- ═══ iOS / Safari PWA ═══ -->
    <!-- Ermöglicht "Zum Home-Bildschirm" als vollständige App ohne Browser-UI -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <!-- Statusbar-Stil: black-translucent = App nutzt den gesamten Bildschirm inkl. Notch-Bereich -->
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="WedPlan" />

    <!-- ═══ Apple Touch Icons (für Home-Screen Shortcut auf iOS) ═══ -->
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="apple-touch-icon" sizes="152x152" href="/icons/icon-152.png" />
    <link rel="apple-touch-icon" sizes="192x192" href="/icons/icon-192.png" />

    <!-- ═══ Standard Favicon ═══ -->
    <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png" />
    <link rel="icon" type="image/png" href="favicon.png" />

    <!-- ═══ Stylesheets ═══ -->
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["WedPlan.styles.css"]" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet" />

    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />

    <!-- ═══ Splash-Screen Styles (inline, damit sofort sichtbar) ═══ -->
    <style>
        #app-splash {
            position: fixed;
            inset: 0;
            z-index: 99999;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(160deg, #2D1B1F 0%, #4a2e34 100%);
            color: #fff;
            font-family: 'Poppins', system-ui, sans-serif;
            transition: opacity .5s ease;
        }
        #app-splash.app-splash--hidden { opacity: 0; pointer-events: none; }
        .app-splash__inner { text-align: center; padding: 24px; }
        .app-splash__heart {
            font-size: 46px;
            color: #D6A6AC;
            animation: splash-beat 1.2s ease-in-out infinite;
        }
        .app-splash__title {
            font-family: 'Cormorant Garamond', Georgia, serif;
            font-size: 34px;
            font-weight: 600;
            margin-top: 8px;
            letter-spacing: .5px;
        }
        .app-splash__spinner {
            width: 34px;
            height: 34px;
            margin: 22px auto 0;
            border: 3px solid rgba(214,166,172,.3);
            border-top-color: #D6A6AC;
            border-radius: 50%;
            animation: splash-spin .8s linear infinite;
        }
        .app-splash__hint { margin-top: 16px; font-size: 14px; opacity: .8; }
        @@keyframes splash-spin { to { transform: rotate(360deg); } }
        @@keyframes splash-beat {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.18); }
        }
    </style>

    <ImportMap />
    <HeadOutlet />
</head>

<body>
    <!-- ═══ Sofort sichtbarer Ladebildschirm (Splash) ═══ -->
    <!-- Wird angezeigt, bevor Blazor geladen ist, und automatisch entfernt, sobald die App läuft. -->
    <div id="app-splash">
        <div class="app-splash__inner">
            <div class="app-splash__heart">❤</div>
            <div class="app-splash__title">WedPlan</div>
            <div class="app-splash__spinner"></div>
            <div class="app-splash__hint">Eure Hochzeitsplanung wird geladen …</div>
        </div>
    </div>

    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>

    <!-- ═══ Splash entfernen, sobald Blazor gestartet ist ═══ -->
    <script>
        (function () {
            function hideSplash() {
                var el = document.getElementById('app-splash');
                if (el) { el.classList.add('app-splash--hidden'); setTimeout(function () { el.remove(); }, 600); }
            }
            // Sobald der interaktive Inhalt (App-Layout oder Login) sichtbar wird, Splash ausblenden.
            var observer = new MutationObserver(function () {
                if (document.querySelector('.mud-layout') || document.querySelector('.login-wrapper')) {
                    hideSplash();
                    observer.disconnect();
                }
            });
            observer.observe(document.body, { childList: true, subtree: true });
            // Sicherheits-Fallback, damit der Splash nie dauerhaft hängen bleibt.
            setTimeout(hideSplash, 20000);
        })();
    </script>

    <!-- ═══ Service Worker Registrierung ═══ -->
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', function () {
                navigator.serviceWorker.register('/service-worker.js')
                    .then(reg => console.log('[PWA] Service Worker registriert:', reg.scope))
                    .catch(err => console.warn('[PWA] Service Worker Fehler:', err));
            });
        }
    </script>
</body>

</html>
