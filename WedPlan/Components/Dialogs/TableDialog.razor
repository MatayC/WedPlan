@using WedPlan.Models
@using WedPlan.Models

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@(IsEdit ? Icons.Material.Filled.Edit : Icons.Material.Filled.TableRestaurant)"
                     Class="me-2" />
            @(IsEdit ? "Tisch bearbeiten" : "Neuen Tisch anlegen")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_isValid">
            <MudGrid>
                <MudItem xs="12">
                    <MudTextField @bind-Value="Model.Name"
                                  Label="Tischname / Nummer"
                                  Placeholder="z.B. Tisch 1 oder Familientisch"
                                  Required="true"
                                  RequiredError="Bitte einen Tischnamen eingeben."
                                  Variant="Variant.Outlined"
                                  FullWidth="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect @bind-Value="Model.Shape"
                               Label="Form"
                               Variant="Variant.Outlined"
                               FullWidth="true">
                        @foreach (TableShape shape in Enum.GetValues<TableShape>())
                        {
                            <MudSelectItem Value="shape">
                                @ShapeLabel(shape)
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="Model.Capacity"
                                     Label="Maximale Plätze"
                                     Min="1" Max="50"
                                     Variant="Variant.Outlined"
                                     FullWidth="true"
                                     Required="true"
                                     RequiredError="Bitte eine Kapazität angeben." />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Abbrechen</MudButton>
        <MudButton OnClick="Submit"
                   Color="Color.Primary"
                   Variant="Variant.Filled"
                   Disabled="!_isValid">
            @(IsEdit ? "Speichern" : "Anlegen")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public SeatingTable Model { get; set; } = new();
    [Parameter] public bool IsEdit { get; set; }

    private MudForm _form = default!;
    private bool _isValid;

    private static string ShapeLabel(TableShape s) => s switch
    {
        TableShape.Rund  => "🔵 Rund",
        TableShape.Eckig => "🟦 Eckig",
        TableShape.Lang  => "▬ Lang",
        _                => s.ToString()
    };

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await _form.Validate();
        if (_isValid)
            MudDialog.Close(DialogResult.Ok(Model));
    }
}
