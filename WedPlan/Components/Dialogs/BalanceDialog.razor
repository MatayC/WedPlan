@using WedPlan.Models

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Savings" Class="mr-2" />
            Kontostand eintragen
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudSelect @bind-Value="_model.Person" Label="Person" Variant="Variant.Outlined">
                        <MudSelectItem Value="FinancePerson.Partner1">@_partner1</MudSelectItem>
                        <MudSelectItem Value="FinancePerson.Partner2">@_partner2</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="_month" Label="Monat" Variant="Variant.Outlined"
                                   OpenTo="OpenTo.Month" FixDay="1" DateFormat="MMMM yyyy" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="_model.Amount" Label="Kontostand" Variant="Variant.Outlined"
                                     Format="N2" Adornment="Adornment.End" AdornmentText="@_currency" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Notes" Label="Notiz (optional)"
                                  Variant="Variant.Outlined" Lines="2" />
                </MudItem>

                <MudItem xs="12">
                    <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Text">
                        Tipp: Tragt euren Kontostand am besten jeden Monat zum 15. ein,
                        um die Entwicklung gut nachverfolgen zu können.
                    </MudAlert>
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Abbrechen</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync">Speichern</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>Vorbelegte Person.</summary>
    [Parameter]
    public FinancePerson DefaultPerson { get; set; } = FinancePerson.Partner1;

    [Parameter]
    public string Partner1Name { get; set; } = "Partner 1";

    [Parameter]
    public string Partner2Name { get; set; } = "Partner 2";

    [Parameter]
    public string Currency { get; set; } = "€";

    private MudForm _form = default!;
    private FinanceBalance _model = new();
    private DateTime? _month;
    private string _partner1 = "Partner 1";
    private string _partner2 = "Partner 2";
    private string _currency = "€";

    protected override void OnInitialized()
    {
        _partner1 = string.IsNullOrWhiteSpace(Partner1Name) ? "Partner 1" : Partner1Name;
        _partner2 = string.IsNullOrWhiteSpace(Partner2Name) ? "Partner 2" : Partner2Name;
        _currency = string.IsNullOrWhiteSpace(Currency) ? "€" : Currency;

        _model = new FinanceBalance { Person = DefaultPerson };
        _month = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    }

    private async Task SubmitAsync()
    {
        await _form.Validate();
        if (!_form.IsValid) return;

        var m = _month ?? DateTime.Today;
        _model.Month = new DateTime(m.Year, m.Month, 1);
        MudDialog.Close(DialogResult.Ok(_model));
    }

    private void Cancel() => MudDialog.Cancel();
}
