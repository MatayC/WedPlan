@page "/passwort-vergessen"
@layout LoginLayout
@using WedPlan.Services
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Passwort vergessen – WedPlan</PageTitle>

<div class="login-wrapper">
    <MudPaper Elevation="4" Class="login-card pa-6 rounded-xl">
        <div class="d-flex flex-column align-center mb-4">
            <MudIcon Icon="@Icons.Material.Filled.LockReset" Color="Color.Primary" Size="Size.Large" />
            <MudText Typo="Typo.h5" Class="mt-2">Passwort vergessen</MudText>
            <MudText Typo="Typo.body2" Align="Align.Center" Class="mud-text-secondary mt-1">
                Gib deine E-Mail ein. Wir senden dir einen Link zum Zurücksetzen.
            </MudText>
        </div>

        @if (_sent)
        {
            <MudAlert Severity="Severity.Success" Class="mb-3">
                Falls ein Konto mit dieser E-Mail existiert, ist eine E-Mail unterwegs.
                Bitte prüfe dein Postfach (auch den Spam-Ordner).
            </MudAlert>
            <MudButton Variant="Variant.Text" Color="Color.Primary" FullWidth="true"
                       OnClick="@(() => Navigation.NavigateTo("/login"))">
                Zurück zur Anmeldung
            </MudButton>
        }
        else
        {
            <MudForm @ref="_form">
                <MudTextField @bind-Value="_email"
                              Label="E-Mail"
                              InputType="InputType.Email"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="Bitte E-Mail eingeben"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Email"
                              Class="mb-3" />
            </MudForm>

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mb-3" Dense="true">@_error</MudAlert>
            }

            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       Size="Size.Large" Disabled="_busy" OnClick="SubmitAsync" Class="rounded-lg">
                @if (_busy)
                {
                    <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                    <span>Senden…</span>
                }
                else
                {
                    <span>Link senden</span>
                }
            </MudButton>

            <div class="d-flex justify-center mt-3">
                <MudLink Href="/login" Typo="Typo.body2">Zurück zur Anmeldung</MudLink>
            </div>
        }
    </MudPaper>
</div>

@code {
    private MudForm _form = default!;
    private string _email = string.Empty;
    private string? _error;
    private bool _busy;
    private bool _sent;

    private async Task SubmitAsync()
    {
        _error = null;
        await _form.Validate();
        if (!_form.IsValid)
        {
            return;
        }

        _busy = true;
        try
        {
            var result = await AuthService.SendPasswordResetAsync(_email);
            if (result.Success)
            {
                _sent = true;
            }
            else
            {
                _error = result.ErrorMessage;
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
