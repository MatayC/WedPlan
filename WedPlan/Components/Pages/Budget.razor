@page "/budget"
@using System.Globalization
@using WedPlan.Models
@using WedPlan.Services
@using WedPlan.Components.Dialogs
@inject IBudgetService BudgetService
@inject ISettingsService SettingsService
@inject IDialogService DialogService
@inject PermissionService Permissions
@inject ISnackbar Snackbar

<PageTitle>Budget-Planer – WedPlan</PageTitle>

<div class="page-header">
    <MudText Typo="Typo.h3" Class="page-header__title">Budget-Planer</MudText>
    @if (_canEdit)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                   Class="page-header__action" OnClick="@(() => OpenDialogAsync(null))">Ausgabe hinzufügen</MudButton>
    }
</div>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-8" />
}
else
{
    @* ---------- Stat-Karten Übersicht ---------- *@
    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="6" sm="4" lg="2">
            <MudCard Elevation="2" Class="rounded-lg">
                <MudCardContent Class="py-3">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">Gesamtbudget</MudText>
                    <MudText Typo="Typo.h6" Color="Color.Primary">@Fmt(_totalBudget)</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="6" sm="4" lg="2">
            <MudCard Elevation="2" Class="rounded-lg">
                <MudCardContent Class="py-3">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">Geplant</MudText>
                    <MudText Typo="Typo.h6">@Fmt(_sumPlanned)</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="6" sm="4" lg="2">
            <MudCard Elevation="2" Class="rounded-lg">
                <MudCardContent Class="py-3">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">Ausgegeben</MudText>
                    <MudText Typo="Typo.h6" Color="Color.Warning">@Fmt(_sumPaid)</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="6" sm="4" lg="2">
            @* Rot wenn Budget überschritten, sonst Erfolgsgrün *@
            <MudCard Elevation="2" Class="rounded-lg">
                <MudCardContent Class="py-3">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">Verbleibend</MudText>
                    <MudText Typo="Typo.h6" Color="@(_remaining < 0 ? Color.Error : Color.Success)">@Fmt(_remaining)</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="6" sm="4" lg="2">
            <MudCard Elevation="2" Class="rounded-lg">
                <MudCardContent Class="py-3">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">Noch ausstehend</MudText>
                    <MudText Typo="Typo.h6" Color="Color.Info">@Fmt(_outstanding)</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="6" sm="4" lg="2">
            <MudCard Elevation="2" Class="rounded-lg">
                <MudCardContent Class="py-3">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">Posten</MudText>
                    <MudText Typo="Typo.h6">@_allItems.Count</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    @* ---------- Fortschrittsbalken Gesamt ---------- *@
    <MudCard Elevation="2" Class="rounded-lg mb-4">
        <MudCardContent>
            <div class="d-flex justify-space-between mb-1">
                <MudText Typo="Typo.body2">Bezahlt vs. Geplant</MudText>
                <MudText Typo="Typo.body2" Color="Color.Primary">@_paidPercent&#37;</MudText>
            </div>
            <MudProgressLinear Color="@(_remaining < 0 ? Color.Error : Color.Primary)"
                               Value="@_paidPercent" Rounded="true" Size="Size.Large" Class="mb-2" />
            <div class="d-flex justify-space-between">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Bezahlt: @Fmt(_sumPaid)</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Geplant: @Fmt(_sumPlanned)</MudText>
            </div>
        </MudCardContent>
    </MudCard>

    @* ---------- Sparplan (separat vom Budget) ---------- *@
    <MudCard Elevation="2" Class="rounded-lg mb-4">
        <MudCardContent>
            <div class="d-flex align-center mb-1">
                <MudIcon Icon="@Icons.Material.Filled.Savings" Color="Color.Primary" Class="mr-2" />
                <MudText Typo="Typo.h6">Sparplan</MudText>
            </div>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                Erfasst getrennt, wie viel jede Person aktuell gespart hat und monatlich zur Seite legt –
                so seht ihr, ob euer Budget bis zum Hochzeitstag erreicht wird.
            </MudText>

            <MudGrid Spacing="3">
                @* --- Aktuell gespart --- *@
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Aktuell gespart (Konto)</MudText>
                    <MudNumericField T="decimal" Value="_savings1" ValueChanged="@(v => OnSavingsChanged(() => _savings1 = v))"
                                     Label="@($"{PartnerLabel(1)} – Erspartes")" Variant="Variant.Outlined"
                                     Margin="Margin.Dense" Min="0" HideSpinButtons="true" Adornment="Adornment.End"
                                     AdornmentText="@CurrencySymbol()" Disabled="!_canEdit" Class="mb-2" />
                    <MudNumericField T="decimal" Value="_savings2" ValueChanged="@(v => OnSavingsChanged(() => _savings2 = v))"
                                     Label="@($"{PartnerLabel(2)} – Erspartes")" Variant="Variant.Outlined"
                                     Margin="Margin.Dense" Min="0" HideSpinButtons="true" Adornment="Adornment.End"
                                     AdornmentText="@CurrencySymbol()" Disabled="!_canEdit" />
                </MudItem>

                @* --- Monatliche Sparrate --- *@
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Monatlich zur Seite gelegt</MudText>
                    <MudNumericField T="decimal" Value="_monthly1" ValueChanged="@(v => OnSavingsChanged(() => _monthly1 = v))"
                                     Label="@($"{PartnerLabel(1)} – pro Monat")" Variant="Variant.Outlined"
                                     Margin="Margin.Dense" Min="0" HideSpinButtons="true" Adornment="Adornment.End"
                                     AdornmentText="@CurrencySymbol()" Disabled="!_canEdit" Class="mb-2" />
                    <MudNumericField T="decimal" Value="_monthly2" ValueChanged="@(v => OnSavingsChanged(() => _monthly2 = v))"
                                     Label="@($"{PartnerLabel(2)} – pro Monat")" Variant="Variant.Outlined"
                                     Margin="Margin.Dense" Min="0" HideSpinButtons="true" Adornment="Adornment.End"
                                     AdornmentText="@CurrencySymbol()" Disabled="!_canEdit" />

                    @if (_settings.WeddingDate is not null && _monthsUntilWedding > 0)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2 d-block">
                            <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Small" Class="mr-1" />
                            Bei @_monthsUntilWedding @(_monthsUntilWedding == 1 ? "Monat" : "Monaten") theoretisch bis zur Hochzeit:
                        </MudText>
                        <MudText Typo="Typo.caption" Class="d-block ml-4">
                            @PartnerLabel(1): <b>@Fmt(_projected1)</b> · @PartnerLabel(2): <b>@Fmt(_projected2)</b>
                        </MudText>
                    }
                    else if (_settings.WeddingDate is null)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2 d-block">
                            <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="mr-1" />
                            Lege in den Einstellungen ein Hochzeitsdatum fest, damit die verbleibenden Monate automatisch berechnet werden.
                        </MudText>
                    }
                </MudItem>
            </MudGrid>

            <MudDivider Class="my-3" />

            @* --- Zusammenfassung / Hochrechnung --- *@
            <MudGrid Spacing="3">
                <MudItem xs="6" md="3">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">Aktuell zusammen</MudText>
                    <MudText Typo="Typo.h6" Color="Color.Primary">@Fmt(_savingsTotalNow)</MudText>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
                        Monate bis zur Hochzeit
                    </MudText>
                    <MudText Typo="Typo.h6">@_monthsUntilWedding</MudText>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">Voraussichtlich gespart</MudText>
                    <MudText Typo="Typo.h6" Color="Color.Info">@Fmt(_projectedTotal)</MudText>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">Ziel (Gesamtbudget)</MudText>
                    <MudText Typo="Typo.h6">@Fmt(_totalBudget)</MudText>
                </MudItem>
            </MudGrid>

            @if (_totalBudget > 0)
            {
                <div class="d-flex justify-space-between mt-3 mb-1">
                    <MudText Typo="Typo.body2">Zielerreichung (Prognose)</MudText>
                    <MudText Typo="Typo.body2" Color="@(_goalReached ? Color.Success : Color.Warning)">@_goalPercent&#37;</MudText>
                </div>
                <MudProgressLinear Color="@(_goalReached ? Color.Success : Color.Warning)"
                                   Value="@_goalPercent" Rounded="true" Size="Size.Large" />
                <MudText Typo="Typo.caption" Class="d-block mt-2"
                         Color="@(_goalReached ? Color.Success : Color.Warning)">
                    @if (_goalReached)
                    {
                        <span>
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Class="mr-1" />
                            Ihr erreicht euer Ziel voraussichtlich – Überschuss: @Fmt(_projectedTotal - _totalBudget)
                        </span>
                    }
                    else
                    {
                        <span>
                            <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Class="mr-1" />
                            Es fehlen voraussichtlich noch @Fmt(_totalBudget - _projectedTotal) bis zum Hochzeitstag.
                        </span>
                    }
                </MudText>
            }
            else
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2 d-block">
                    Lege in den Einstellungen ein Gesamtbudget und Hochzeitsdatum fest, um die Zielerreichung zu sehen.
                </MudText>
            }
        </MudCardContent>
    </MudCard>

    @* ---------- Charts ---------- *@
    @if (_allItems.Count > 0)
    {
        <MudGrid Spacing="3" Class="mb-4">
            <MudItem xs="12" md="6">
                <MudCard Elevation="2" Class="rounded-lg">
                    <MudCardContent>
                        <MudText Typo="Typo.h6" GutterBottom="true">Ausgaben nach Kategorie</MudText>
                        @if (_categoryChartData.Length > 0)
                        {
                            <MudChart T="double" ChartType="ChartType.Donut" Width="100%" Height="240px"
                                      InputData="@_categoryChartData" InputLabels="@_categoryChartLabels"
                                      ChartOptions="@_chartOptions" />
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudCard Elevation="2" Class="rounded-lg">
                    <MudCardContent>
                        <MudText Typo="Typo.h6" GutterBottom="true">Status der Posten</MudText>
                        @if (_statusChartData.Length > 0)
                        {
                            <MudChart T="double" ChartType="ChartType.Donut" Width="100%" Height="240px"
                                      InputData="@_statusChartData" InputLabels="@_statusChartLabels"
                                      ChartOptions="@_chartOptions" />
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    }

    @* ---------- Filter- und Steuerleiste ---------- *@
    <MudCard Elevation="1" Class="rounded-lg mb-4">
        <MudCardContent>
            <MudGrid Spacing="2" Class="align-center">
                <MudItem xs="12" md="5">
                    <MudTextField Value="_searchTerm" ValueChanged="@((string v) => OnSearchChanged(v))"
                                  Immediate="true" Placeholder="Posten suchen …"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" />
                </MudItem>
                <MudItem xs="12" md="7" Class="d-flex align-center justify-md-end flex-wrap gap-2">
                    <MudChipSet T="BudgetStatus?" SelectedValue="_statusFilter" SelectedValueChanged="OnStatusFilterChanged"
                                SelectionMode="SelectionMode.SingleSelection" Variant="Variant.Filled">
                        <MudChip T="BudgetStatus?" Value="@((BudgetStatus?)null)" Default="true">Alle</MudChip>
                        <MudChip T="BudgetStatus?" Value="@((BudgetStatus?)BudgetStatus.Geplant)" Color="Color.Default">Geplant</MudChip>
                        <MudChip T="BudgetStatus?" Value="@((BudgetStatus?)BudgetStatus.Beauftragt)" Color="Color.Info">Beauftragt</MudChip>
                        <MudChip T="BudgetStatus?" Value="@((BudgetStatus?)BudgetStatus.Angezahlt)" Color="Color.Warning">Angezahlt</MudChip>
                        <MudChip T="BudgetStatus?" Value="@((BudgetStatus?)BudgetStatus.Bezahlt)" Color="Color.Success">Bezahlt</MudChip>
                    </MudChipSet>
                </MudItem>
                <MudItem xs="12" Class="d-flex align-center">
                    <MudText Typo="Typo.body2" Class="mr-3 mud-text-secondary">Gruppieren nach:</MudText>
                    <MudToggleGroup T="GroupMode" Value="_groupMode" ValueChanged="OnGroupModeChanged"
                                    Color="Color.Primary" Size="Size.Small" CheckMark="true">
                        <MudToggleItem Value="GroupMode.Category" Text="Kategorie" />
                        <MudToggleItem Value="GroupMode.Status" Text="Status" />
                    </MudToggleGroup>
                </MudItem>
            </MudGrid>
        </MudCardContent>
    </MudCard>

    @* ---------- Gruppierte Postenliste ---------- *@
    @if (_filteredItems.Count == 0)
    {
        <MudCard Elevation="2" Class="rounded-lg">
            <MudCardContent Class="d-flex flex-column align-center py-8">
                <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Color="Color.Secondary" Size="Size.Large" />
                <MudText Typo="Typo.h6" Class="mt-3">Keine Ausgaben gefunden.</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    @(_allItems.Count == 0 ? "Füge eure erste Ausgabe hinzu." : "Passe Suche oder Filter an.")
                </MudText>
            </MudCardContent>
        </MudCard>
    }
    else
    {
        <MudExpansionPanels MultiExpansion="true" Elevation="2" Class="rounded-lg">
            @foreach (var group in _groupedItems)
            {
                <MudExpansionPanel Expanded="true">
                    <TitleContent>
                        <div class="d-flex align-center justify-space-between" style="width:100%">
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.Category" Color="Color.Primary" Class="mr-2" />
                                <MudText Typo="Typo.subtitle1"><b>@group.Key</b></MudText>
                                <MudChip T="string" Size="Size.Small" Class="ml-2" Variant="Variant.Text">@group.Count() Posten</MudChip>
                            </div>
                            <MudText Typo="Typo.body2" Color="Color.Primary">@Fmt(group.Sum(i => i.EstimatedCost))</MudText>
                        </div>
                    </TitleContent>
                    <ChildContent>
                        @* Desktop: Tabelle *@
                        <MudHidden Breakpoint="Breakpoint.SmAndDown">
                            <MudTable Items="group" Dense="true" Hover="true" Elevation="0" Breakpoint="Breakpoint.None">
                                <HeaderContent>
                                    <MudTh>Bezeichnung</MudTh>
                                    <MudTh>Lieferant</MudTh>
                                    <MudTh Style="text-align:right">Geplant</MudTh>
                                    <MudTh Style="text-align:right">Tatsächlich</MudTh>
                                    <MudTh Style="text-align:right">Bezahlt</MudTh>
                                    <MudTh>Status</MudTh>
                                    <MudTh>Fällig</MudTh>
                                    <MudTh Style="text-align:right">Aktionen</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="Bezeichnung">
                                        <MudText Typo="Typo.body2"><b>@context.Title</b></MudText>
                                        @if (!string.IsNullOrWhiteSpace(context.Notes))
                                        {
                                            <MudTooltip Text="@context.Notes">
                                                <MudIcon Icon="@Icons.Material.Filled.Notes" Size="Size.Small" Class="mud-text-secondary" />
                                            </MudTooltip>
                                        }
                                    </MudTd>
                                    <MudTd DataLabel="Lieferant">
                                        <MudText Typo="Typo.caption">@(context.Vendor ?? "–")</MudText>
                                    </MudTd>
                                    <MudTd DataLabel="Geplant" Style="text-align:right">
                                        <MudText Typo="Typo.body2">@Fmt(context.EstimatedCost)</MudText>
                                    </MudTd>
                                    <MudTd DataLabel="Tatsächlich" Style="text-align:right">
                                        <MudText Typo="Typo.body2"
                                                 Color="@(context.ActualCost > context.EstimatedCost ? Color.Error : Color.Default)">
                                            @Fmt(context.ActualCost)
                                        </MudText>
                                    </MudTd>
                                    <MudTd DataLabel="Bezahlt" Style="text-align:right">
                                        <div>
                                            <MudText Typo="Typo.body2" Color="Color.Success">@Fmt(context.PaidAmount)</MudText>
                                            @if (context.ActualCost > 0)
                                            {
                                                <MudProgressLinear Value="@PaidPercent(context)" Color="Color.Success"
                                                                   Rounded="true" Size="Size.Small" Class="mt-1" />
                                            }
                                        </div>
                                    </MudTd>
                                    <MudTd DataLabel="Status">
                                        <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Status)" Variant="Variant.Filled">
                                            @context.Status
                                        </MudChip>
                                    </MudTd>
                                    <MudTd DataLabel="Fällig">
                                        @if (context.DueDate.HasValue)
                                        {
                                            <MudText Typo="Typo.caption"
                                                     Color="@(context.DueDate.Value < DateTime.Today && context.Status != BudgetStatus.Bezahlt ? Color.Error : Color.Default)">
                                                @context.DueDate.Value.ToString("dd.MM.yy", _culture)
                                            </MudText>
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.caption" Class="mud-text-secondary">–</MudText>
                                        }
                                    </MudTd>
                                    <MudTd DataLabel="Aktionen" Style="text-align:right">
                                        @if (_canEdit)
                                        {
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                                           OnClick="@(() => OpenDialogAsync(context))" aria-label="Bearbeiten" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                           OnClick="@(() => DeleteAsync(context))" aria-label="Löschen" />
                                        }
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        </MudHidden>

                        @* Mobile: Karten *@
                        <MudHidden Breakpoint="Breakpoint.MdAndUp">
                            @foreach (var item in group)
                            {
                                <MudPaper Elevation="0" Class="pa-3 mb-2 rounded-lg budget-item-card">
                                    <div class="d-flex justify-space-between align-start">
                                        <div>
                                            <MudText Typo="Typo.body1"><b>@item.Title</b></MudText>
                                            @if (!string.IsNullOrWhiteSpace(item.Vendor))
                                            {
                                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@item.Vendor</MudText>
                                            }
                                        </div>
                                        <div class="d-flex">
                                            <MudChip T="string" Size="Size.Small" Color="@StatusColor(item.Status)" Variant="Variant.Filled">
                                                @item.Status
                                            </MudChip>
                                            @if (_canEdit)
                                            {
                                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                                               OnClick="@(() => OpenDialogAsync(item))" />
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                               OnClick="@(() => DeleteAsync(item))" />
                                            }
                                        </div>
                                    </div>
                                    <MudDivider Class="my-2" />
                                    <div class="d-flex justify-space-between">
                                        <div>
                                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Geplant</MudText>
                                            <MudText Typo="Typo.body2">@Fmt(item.EstimatedCost)</MudText>
                                        </div>
                                        <div>
                                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Tatsächlich</MudText>
                                            <MudText Typo="Typo.body2"
                                                     Color="@(item.ActualCost > item.EstimatedCost ? Color.Error : Color.Default)">
                                                @Fmt(item.ActualCost)
                                            </MudText>
                                        </div>
                                        <div>
                                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Bezahlt</MudText>
                                            <MudText Typo="Typo.body2" Color="Color.Success">@Fmt(item.PaidAmount)</MudText>
                                        </div>
                                    </div>
                                    @if (item.ActualCost > 0)
                                    {
                                        <MudProgressLinear Value="@PaidPercent(item)" Color="Color.Success"
                                                           Rounded="true" Size="Size.Small" Class="mt-2" />
                                    }
                                    @if (item.DueDate.HasValue)
                                    {
                                        <MudText Typo="Typo.caption" Class="mt-1 d-block"
                                                 Color="@(item.DueDate.Value < DateTime.Today && item.Status != BudgetStatus.Bezahlt ? Color.Error : Color.Default)">
                                            <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" Class="mr-1" />
                                            Fällig: @item.DueDate.Value.ToString("dd. MMM yyyy", _culture)
                                        </MudText>
                                    }
                                </MudPaper>
                            }
                        </MudHidden>
                    </ChildContent>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    }
}

@code {
    private enum GroupMode { Category, Status }

    private readonly CultureInfo _culture = new("de-DE");
    private bool _loading = true;
    private bool _canEdit;

    private List<BudgetItem> _allItems = new();
    private List<BudgetItem> _filteredItems = new();
    private List<IGrouping<string, BudgetItem>> _groupedItems = new();

    // Filter-/Ansichtszustand
    private string _searchTerm = string.Empty;
    private BudgetStatus? _statusFilter;
    private GroupMode _groupMode = GroupMode.Category;

    // Einstellungen
    private string _currency = "EUR";
    private decimal _totalBudget;
    private WeddingSettings _settings = new();

    // Sparplan
    private decimal _savings1;
    private decimal _savings2;
    private decimal _monthly1;
    private decimal _monthly2;
    private decimal _savingsTotalNow;
    private int _monthsUntilWedding;
    private decimal _projectedTotal;
    private decimal _projected1;
    private decimal _projected2;
    private double _goalPercent;
    private bool _goalReached;

    // Statistiken
    private decimal _sumPlanned;
    private decimal _sumPaid;
    private decimal _remaining;
    private decimal _outstanding;
    private double _paidPercent;

    // Chart-Daten
    private double[] _categoryChartData = Array.Empty<double>();
    private string[] _categoryChartLabels = Array.Empty<string>();
    private double[] _statusChartData = Array.Empty<double>();
    private string[] _statusChartLabels = Array.Empty<string>();

    private readonly ChartOptions _chartOptions = new()
    {
        ChartPalette = new[] { "#C9A227", "#E8B4B8", "#B98A8D", "#7BA17D", "#8AA0B5", "#D9A441", "#C15B5B", "#4A8C6F", "#A3B899", "#D4A9A1" }
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Unabhängige Ladevorgänge parallel ausführen → weniger Wartezeit.
            var permTask = Permissions.EnsureLoadedAsync();
            var settingsTask = SettingsService.GetAsync();
            var itemsTask = BudgetService.GetAllAsync();
            await Task.WhenAll(permTask, settingsTask, itemsTask);

            _canEdit = Permissions.CanEdit(WeddingPages.Budget);
            var settings = await settingsTask;
            _settings = settings;
            _currency = settings.Currency ?? "EUR";
            _totalBudget = settings.TotalBudget;
            _savings1 = settings.SavingsPartner1;
            _savings2 = settings.SavingsPartner2;
            _monthly1 = settings.MonthlySavingPartner1;
            _monthly2 = settings.MonthlySavingPartner2;
            RecalculateSavings();

            _allItems = await itemsTask;
            RecalculateStats();
            ApplyFilters();
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task ReloadAsync()
    {
        _allItems = await BudgetService.GetAllAsync(forceRefresh: true);
        RecalculateStats();
        ApplyFilters();
    }

    private void RecalculateStats()
    {
        // Geplante Kosten: EstimatedCost oder – falls nicht gesetzt – ActualCost.
        _sumPlanned = _allItems.Sum(i => i.EstimatedCost > 0 ? i.EstimatedCost : i.ActualCost);
        _sumPaid = _allItems.Sum(i => i.PaidAmount);

        // Ausstehend = Tatsächliche Kosten – Bezahlt.
        _outstanding = _allItems.Sum(i => Math.Max(0, (i.ActualCost > 0 ? i.ActualCost : i.EstimatedCost) - i.PaidAmount));
        _remaining = _totalBudget - _sumPaid;
        _paidPercent = _sumPlanned > 0 ? Math.Min(100d, (double)(_sumPaid / _sumPlanned) * 100d) : 0d;

        // Donut: Ausgaben nach Kategorie (tatsächliche oder geplante Kosten).
        var byCategory = _allItems
            .GroupBy(i => string.IsNullOrWhiteSpace(i.Category) ? "Sonstiges" : i.Category)
            .Select(g => new { g.Key, Sum = g.Sum(i => i.EstimatedCost > 0 ? i.EstimatedCost : i.ActualCost) })
            .Where(x => x.Sum > 0)
            .OrderByDescending(x => x.Sum)
            .ToList();

        _categoryChartData = byCategory.Select(x => (double)x.Sum).ToArray();
        _categoryChartLabels = byCategory.Select(x => x.Key).ToArray();

        // Donut: Status-Verteilung der Posten.
        var byStatus = _allItems
            .GroupBy(i => i.Status.ToString())
            .Select(g => new { g.Key, Count = (double)g.Count() })
            .OrderBy(g => g.Key)
            .ToList();

        _statusChartData = byStatus.Select(x => x.Count).ToArray();
        _statusChartLabels = byStatus.Select(x => x.Key).ToArray();
    }

    private void ApplyFilters()
    {
        IEnumerable<BudgetItem> query = _allItems;

        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            query = query.Where(i => i.Title.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)
                                  || (i.Vendor ?? "").Contains(_searchTerm, StringComparison.OrdinalIgnoreCase));
        }

        if (_statusFilter is not null)
        {
            query = query.Where(i => i.Status == _statusFilter);
        }

        _filteredItems = query.OrderBy(i => i.Category).ThenBy(i => i.Title).ToList();

        // Gruppierung je nach Modus.
        _groupedItems = _groupMode == GroupMode.Category
            ? _filteredItems.GroupBy(i => string.IsNullOrWhiteSpace(i.Category) ? "Sonstiges" : i.Category)
                            .OrderBy(g => g.Key).ToList()
            : _filteredItems.GroupBy(i => i.Status.ToString()).OrderBy(g => g.Key).ToList();
    }

    private void OnSearchChanged(string value)
    {
        _searchTerm = value ?? string.Empty;
        ApplyFilters();
    }

    private void OnStatusFilterChanged(BudgetStatus? value)
    {
        _statusFilter = value;
        ApplyFilters();
    }

    private void OnGroupModeChanged(GroupMode value)
    {
        _groupMode = value;
        ApplyFilters();
    }

    private async Task OpenDialogAsync(BudgetItem? item)
    {
        var parameters = new DialogParameters<BudgetDialog>
        {
            { x => x.Item, item },
            { x => x.Currency, CurrencySymbol() }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<BudgetDialog>(
            item is null ? "Ausgabe hinzufügen" : "Ausgabe bearbeiten", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled && result.Data is BudgetItem edited)
        {
            if (item is null)
            {
                await BudgetService.AddAsync(edited);
                Snackbar.Add($"'{edited.Title}' wurde hinzugefügt.", Severity.Success);
            }
            else
            {
                await BudgetService.UpdateAsync(edited);
                Snackbar.Add($"'{edited.Title}' wurde aktualisiert.", Severity.Success);
            }
            await ReloadAsync();
        }
    }

    private async Task DeleteAsync(BudgetItem item)
    {
        var options = new MessageBoxOptions
        {
            Title = "Ausgabe löschen",
            Message = $"Möchtest du '{item.Title}' wirklich löschen?",
            YesText = "Löschen",
            CancelText = "Abbrechen"
        };

        var confirmed = await DialogService.ShowMessageBoxAsync(options);

        if (confirmed == true)
        {
            await BudgetService.DeleteAsync(item.Id);
            Snackbar.Add($"'{item.Title}' wurde gelöscht.", Severity.Info);
            await ReloadAsync();
        }
    }

    // Speichert eine geänderte Sparplan-Eingabe und rechnet die Prognose neu.
    private async Task OnSavingsChanged(Action apply)
    {
        apply();
        _settings.SavingsPartner1 = _savings1;
        _settings.SavingsPartner2 = _savings2;
        _settings.MonthlySavingPartner1 = _monthly1;
        _settings.MonthlySavingPartner2 = _monthly2;
        RecalculateSavings();
        await SettingsService.SaveAsync(_settings);
    }

    // Berechnet aktuelle Summe, Monate bis zur Hochzeit und die Sparprognose.
    private void RecalculateSavings()
    {
        _savingsTotalNow = _savings1 + _savings2;
        _monthsUntilWedding = MonthsUntilWedding();

        // Theoretisch bis zur Hochzeit gesamt Erspartes je Partner:
        // aktuell Erspartes + monatliche Rate × verbleibende Monate.
        _projected1 = _savings1 + _monthly1 * _monthsUntilWedding;
        _projected2 = _savings2 + _monthly2 * _monthsUntilWedding;
        _projectedTotal = _projected1 + _projected2;

        _goalPercent = _totalBudget > 0
            ? Math.Min(100d, (double)(_projectedTotal / _totalBudget) * 100d)
            : 0d;
        _goalReached = _totalBudget > 0 && _projectedTotal >= _totalBudget;
    }

    // Volle Monate zwischen heute und dem Hochzeitsdatum (mind. 0).
    private int MonthsUntilWedding()
    {
        if (_settings.WeddingDate is not DateTime date)
        {
            return 0;
        }

        var today = DateTime.Today;
        if (date <= today)
        {
            return 0;
        }

        var months = (date.Year - today.Year) * 12 + date.Month - today.Month;
        if (date.Day < today.Day)
        {
            months--;
        }
        return Math.Max(0, months);
    }

    // Beschriftung eines Partners (Fallback wenn kein Name gesetzt ist).
    private string PartnerLabel(int partner)
    {
        var name = partner == 1 ? _settings.Partner1Name : _settings.Partner2Name;
        return string.IsNullOrWhiteSpace(name) ? $"Partner {partner}" : name;
    }

    // Bezahlt-Prozent eines einzelnen Postens (für den Inline-Fortschrittsbalken).
    private static double PaidPercent(BudgetItem item)
    {
        var total = item.ActualCost > 0 ? item.ActualCost : item.EstimatedCost;
        return total > 0 ? Math.Min(100d, (double)(item.PaidAmount / total) * 100d) : 0d;
    }

    // Formatiert einen Betrag mit der eingestellten Währung.
    private string Fmt(decimal amount)
        => string.Format(_culture, "{0:N2} {1}", amount, CurrencySymbol());

    // Gibt das Währungssymbol aus dem ISO-Code zurück.
    private string CurrencySymbol() => _currency switch
    {
        "EUR" => "€",
        "CHF" => "CHF",
        "USD" => "$",
        "GBP" => "£",
        _ => _currency
    };

    // Farbe je Budget-Status.
    private static Color StatusColor(BudgetStatus status) => status switch
    {
        BudgetStatus.Bezahlt => Color.Success,
        BudgetStatus.Angezahlt => Color.Warning,
        BudgetStatus.Beauftragt => Color.Info,
        _ => Color.Default
    };
}
