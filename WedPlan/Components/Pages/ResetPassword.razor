@page "/passwort-neu"
@layout LoginLayout
@using WedPlan.Services
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Neues Passwort – WedPlan</PageTitle>

<div class="login-wrapper">
    <MudPaper Elevation="4" Class="login-card pa-6 rounded-xl">
        <div class="d-flex flex-column align-center mb-4">
            <MudIcon Icon="@Icons.Material.Filled.Password" Color="Color.Primary" Size="Size.Large" />
            <MudText Typo="Typo.h5" Class="mt-2">Neues Passwort</MudText>
            <MudText Typo="Typo.body2" Align="Align.Center" Class="mud-text-secondary mt-1">
                Wähle ein neues Passwort für dein Konto.
            </MudText>
        </div>

        @if (_done)
        {
            <MudAlert Severity="Severity.Success" Class="mb-3">
                Dein Passwort wurde geändert. Du kannst dich jetzt anmelden.
            </MudAlert>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       OnClick="@(() => Navigation.NavigateTo("/login"))">
                Zur Anmeldung
            </MudButton>
        }
        else
        {
            <MudForm @ref="_form">
                <MudTextField @bind-Value="_password"
                              Label="Neues Passwort"
                              InputType="InputType.Password"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="Bitte Passwort eingeben"
                              HelperText="Mindestens 6 Zeichen"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Lock"
                              Class="mb-3" />

                <MudTextField @bind-Value="_passwordRepeat"
                              Label="Passwort wiederholen"
                              InputType="InputType.Password"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="Bitte Passwort wiederholen"
                              Validation="@(new Func<string, string?>(ValidateRepeat))"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Lock"
                              Class="mb-2" />
            </MudForm>

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mb-3" Dense="true">@_error</MudAlert>
            }

            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       Size="Size.Large" Disabled="_busy" OnClick="SubmitAsync" Class="rounded-lg">
                @if (_busy)
                {
                    <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                    <span>Speichern…</span>
                }
                else
                {
                    <span>Passwort speichern</span>
                }
            </MudButton>
        }
    </MudPaper>
</div>

@code {
    private MudForm _form = default!;
    private string _password = string.Empty;
    private string _passwordRepeat = string.Empty;
    private string? _error;
    private bool _busy;
    private bool _done;

    private string? ValidateRepeat(string value)
        => value == _password ? null : "Die Passwörter stimmen nicht überein.";

    private async Task SubmitAsync()
    {
        _error = null;
        await _form.Validate();
        if (!_form.IsValid)
        {
            return;
        }

        _busy = true;
        try
        {
            var result = await AuthService.UpdatePasswordAsync(_password);
            if (result.Success)
            {
                _done = true;
            }
            else
            {
                _error = result.ErrorMessage;
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
